{
  "manifest_version": 3,
  "name": "The Vault - a permanent history",
  "short_name": "The Vault",
  "version": "1.15.0",
  "description": "Keep a private, searchable local archive of browsing and download history. Retain it until you choose to delete it.",
  "minimum_chrome_version": "120",
  "permissions": [
    "history",
    "downloads",
    "tabs",
    "storage",
    "unlimitedStorage",
    "contextMenus",
    "alarms",
    "sessions",
    "favicon"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Open The Vault",
    "default_icon": {
      "16": "icons/logo-16.png",
      "32": "icons/logo-32.png",
      "128": "icons/logo-128.png"
    }
  },
  "icons": {
    "16": "icons/logo-16.png",
    "32": "icons/logo-32.png",
    "48": "icons/logo-48.png",
    "128": "icons/logo-128.png"
  },
  "chrome_url_overrides": {
    "history": "history.html"
  },
  "options_ui": {
    "page": "history.html#settings",
    "open_in_tab": true
  },
  "incognito": "not_allowed",
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; connect-src 'none'; base-uri 'none'"
  }
}
